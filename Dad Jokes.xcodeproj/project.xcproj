{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages/PiperSpeech",
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "App",
      "target-membership": [
        "Dad Jokes",
      ],
      "membership-exceptions": [
        {
          "target": "Dad Jokes",
          "exclusions": [
            "Assets.xcassets",
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Watch",
      "target-membership": [
        "Dad Jokes Watch",
      ],
      "membership-exceptions": [
        {
          "target": "Dad Jokes Watch",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Dad Jokes.app", "id": "83EFDDE630B318A600FFFFFF", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Dad Jokes Watch.app", "id": "83F6726830B319B000FFFFFF", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Dad Jokes/copy/Embed Watch Content", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Dad Jokes Widget Extension.appex", "id": "833A08E030B319BA00FFFFFF", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Dad Jokes/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Dad Jokes Watch Widget Extension.appex", "id": "831E08EE30B319C800FFFFFF", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Dad Jokes Watch/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Dad Jokes Voices.appex", "id": "83D3FB6830B32B4300FFFFFF", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Dad Jokes/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    }, {
      "kind": "folder",
      "path": "Widget Extension",
      "target-membership": [
        "Dad Jokes Watch Widget Extension",
        "Dad Jokes Widget Extension",
      ],
      "membership-exceptions": [
        {
          "target": "Dad Jokes Widget Extension",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "Dad Jokes Watch Widget Extension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Shared", "target-membership": [ "Dad Jokes", "Dad Jokes Watch", "Dad Jokes Watch Widget Extension", "Dad Jokes Widget Extension" ] },
    {
      "kind": "group",
      "name": "Watch Artwork",
      "children": [
        {
          "path": "App/Assets.xcassets",
          "target-membership": [
            "Dad Jokes/resources",
            "Dad Jokes Watch/resources",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Speech Provider",
      "target-membership": [
        "Dad Jokes Voices",
      ],
      "membership-exceptions": [
        {
          "target": "Dad Jokes Voices",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
  ],
  "targets": [
    {
      "name": "Dad Jokes",
      "id": "83EFDDE530B318A600FFFFFF",
      "product": "Products/Dad Jokes.app",
      "product-type": "application",
      "dependencies": [
        "Dad Jokes Widget Extension",
        { "target": "Dad Jokes Watch", "platforms": [ "ios" ] },
        "Dad Jokes Voices",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
        "frameworks",
      ],
      "package-product-members": [
        {
          "package": "PiperSpeech",
          "product-name": "PiperSpeech",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS[config=Debug]": "App/Dad Jokes.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Debug][sdk=macosx*]": "App/Local Preview.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Release]": "App/Dad Jokes.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "iPhone Developer",
        "CODE_SIGN_IDENTITY[config=Debug][sdk=macosx*]": "-",
        "CODE_SIGN_IDENTITY[config=Release]": "iPhone Developer",
        "CODE_SIGN_IDENTITY[config=Release][sdk=macosx*]": "Apple Development",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_USER_SELECTED_FILES[sdk=macosx*]": "readwrite",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "App/Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "2.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.Mimikmeapps.DadJokes",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug][sdk=macosx*]": "$(inherited) DEBUG DAD_JOKES_LOCAL_PREVIEW",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "Dad Jokes Watch",
      "id": "83F6726730B319B000FFFFFF",
      "product": "Products/Dad Jokes Watch.app",
      "product-type": "application",
      "dependencies": [
        "Dad Jokes Watch Widget Extension",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Watch/Info.plist",
        "MARKETING_VERSION": "2.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.Mimikmeapps.DadJokes.watchkitapp",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "watchos watchsimulator",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "4",
        "WATCHOS_DEPLOYMENT_TARGET": "26.0",
      },
    }, {
      "name": "Dad Jokes Widget Extension",
      "id": "833A08DF30B319BA00FFFFFF",
      "product": "Products/Dad Jokes Widget Extension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "resources",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Widget Extension/Widget.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug][sdk=macosx*]": "-",
        "CODE_SIGN_IDENTITY[config=Release][sdk=macosx*]": "Apple Development",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Widget Extension/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Dad Jokes",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "2.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.Mimikmeapps.DadJokes.widget-extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "Dad Jokes Watch Widget Extension",
      "id": "831E08ED30B319C800FFFFFF",
      "product": "Products/Dad Jokes Watch Widget Extension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "resources",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Widget Extension/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Dad Jokes",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "2.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.Mimikmeapps.DadJokes.watchkitapp.widget-extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "watchos watchsimulator",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "4",
        "WATCHOS_DEPLOYMENT_TARGET": "26.0",
      },
    }, {
      "name": "Dad Jokes Voices",
      "id": "83D3FB6730B32B4300FFFFFF",
      "product": "Products/Dad Jokes Voices.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "PiperSpeech",
          "product-name": "PiperSpeech",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_IDENTITY[config=Debug][sdk=macosx*]": "-",
        "CODE_SIGN_IDENTITY[config=Release][sdk=macosx*]": "Apple Development",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Speech Provider/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Dad Jokes Voices",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "2.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.Mimikmeapps.DadJokes.voices",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_VERSION": "5.0",
  },
  "last-upgrade": "14.3",
}
